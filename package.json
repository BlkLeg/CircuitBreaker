{
  "name": "circuitbreaker",
  "version": "1.0.0-rc.4",
  "private": true,
  "description": "Self-hosted infrastructure discovery, monitoring, and interactive topology visualization for homelabs and private networks.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "npm --prefix apps/frontend test",
    "prepare": "husky"
  },
  "keywords": [
    "homelab",
    "infrastructure",
    "network-discovery",
    "network-monitoring",
    "network-topology",
    "observability",
    "proxmox",
    "self-hosted"
  ],
  "author": {
    "name": "Shawnji",
    "url": "https://github.com/BlkLeg"
  },
  "license": "MIT",
  "homepage": "https://circuitbreaker.shawnji.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlkLeg/CircuitBreaker.git"
  },
  "bugs": {
    "url": "https://github.com/BlkLeg/CircuitBreaker/issues"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2"
  },
  "lint-staged": {
    "*.{ts,tsx,py}": "make lint",
    "apps/**/tests/**": "echo '🚫 Tests blocked from prod paths' && exit 1"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.9"
  }
}
