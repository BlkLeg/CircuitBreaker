# Env files with real secrets (frontend/.env contains only safe defaults)
backend/.env
backend/.env.*
docker/.env
.env.local
.env.*
frontend/.env.local
frontend/.env.*.local
.env
# GOV-12: the e2e harness's own credentials are no longer tracked. The base
# compose file's ${VAR:?...} guards need apps/agent/e2e/.env to exist, so
# ensure_env.py regenerates it from .env.example — run by conftest.py's autouse
# fixture locally and as its own step in e2e.yml. No manual copy is needed.
# Written per-run by the e2e harness's `_write_agent_toml` (it carries that
# run's server_static_pk and tls_pin, which are generated fresh by the mono
# container) and unlinked again in each test's `finally`. Never a source file.
apps/agent/e2e/agent.toml
.envrc
.github/workflows/.env
.github/workflows/.env.*
!.env.example
!deploy/misc/.env.template

