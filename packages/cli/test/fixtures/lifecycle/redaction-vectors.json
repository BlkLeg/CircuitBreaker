{
 "description": "redactText vectors: input, options (max_length in code points, single_line), and the exact output both validators' redaction produces (specs/install/lifecycle-contract.md section 1.7). ASCII-escaped so the lone surrogate survives.",
 "vectors": [
  {
   "name": "credential assignment in an echoed --version",
   "input": "--version 'token=abcdef' is not a release version (for example 0.4.7)",
   "output": "--version 'token (redacted) is not a release version (for example 0.4.7)"
  },
  {
   "name": "spaced password assignment",
   "input": "PASSWORD: hunter2 ok",
   "output": "PASSWORD (redacted) ok"
  },
  {
   "name": "URL userinfo with a password",
   "input": "connect to http://admin:s3cret@proxy.lan:3128 failed",
   "output": "connect to http://[redacted]@proxy.lan:3128 failed"
  },
  {
   "name": "bearer token",
   "input": "Authorization: Bearer abcdefgh12345678",
   "output": "Authorization: Bearer [redacted]"
  },
  {
   "name": "PEM private key with its body",
   "input": "key -----BEGIN OPENSSH PRIVATE KEY-----\nAAAA\n-----END OPENSSH PRIVATE KEY----- end",
   "output": "key [redacted private key] end"
  },
  {
   "name": "PEM private key without an end marker",
   "input": "key -----BEGIN PRIVATE KEY-----\nAAAA",
   "output": "key [redacted private key]"
  },
  {
   "name": "C0 control in an echoed path",
   "input": "no bundle at /tmp/a\u0001x/b.tar.gz",
   "output": "no bundle at /tmp/a\\u0001x/b.tar.gz"
  },
  {
   "name": "ANSI escape in an echoed channel",
   "input": "unknown channel 'x\u001b[31m' (stable or candidate)",
   "output": "unknown channel 'x\\u001b[31m' (stable or candidate)"
  },
  {
   "name": "C1 control sequence introducer and DEL",
   "input": "x\u009by\u007fz",
   "output": "x\\u009by\\u007fz"
  },
  {
   "name": "carriage return",
   "input": "a\r\nb",
   "output": "a\\u000d\nb"
  },
  {
   "name": "tab and newline are kept",
   "input": "a\tb\nc",
   "output": "a\tb\nc"
  },
  {
   "name": "tab and newline escaped on one line",
   "input": "a\tb\nc",
   "options": {
    "single_line": true
   },
   "output": "a\\u0009b\\u000ac"
  },
  {
   "name": "lone surrogate",
   "input": "a\ud800b",
   "output": "a\ufffdb"
  },
  {
   "name": "truncated to the text bound",
   "input": "",
   "output": "\u2026"
  },
  {
   "name": "truncated by code points, not bytes",
   "input": "\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00",
   "options": {
    "max_length": 10
   },
   "output": "\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\u2026"
  },
  {
   "name": "plain text is unchanged",
   "input": "SHA256 mismatch \u2014 b.tar.gz may be corrupted",
   "output": "SHA256 mismatch \u2014 b.tar.gz may be corrupted"
  }
 ]
}
