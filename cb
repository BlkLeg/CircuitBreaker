#!/usr/bin/env bash
#
# cb — Circuit Breaker command-line tool
#
# Installed to /usr/local/bin/cb by install.sh  (or: sudo install -Dm755 ./cb /usr/local/bin/cb)
#
# Usage: cb <command> [options]
#
# Commands:
#   status        Show service / container status
#   doctor        Run health checks and diagnose issues
#   logs [-f]     Show (or follow) logs
#   restart       Restart Circuit Breaker
#   update        Pull latest image and restart  (docker mode only)
#   backup        Full-state snapshot: database, uploads, config, vault key
#   restore       Restore a full-state snapshot  (destructive)
#   migrate       Database schema: migrate status | migrate upgrade
#   token         Scoped API tokens: create | list | rotate | revoke
#   user          Local accounts: list | create | set-role | disable | enable
#   agent         Agent fleet: list | approve | revoke
#   config        Validate the configuration  (cb config validate)
#   vault-recover Recover from an uninitialized vault  (after-crash / headless deploy)
#   version       Show installed version
#   uninstall     Remove Circuit Breaker from this system
#   help          Show this help
#
# Modes (set in ~/.circuit-breaker/install.conf):
#   docker   — single container deployed by install.sh
#   compose  — multi-container stack deployed by docker compose
#   binary   — native binary managed by systemd
#

set -eo pipefail

# ── Config ────────────────────────────────────────────────────────────────────
CB_CONFIG_DIR="${CB_CONFIG_DIR:-$HOME/.circuit-breaker}"
_CONF="$CB_CONFIG_DIR/install.conf"
if [[ ! -f "$_CONF" && -f /etc/circuit-breaker/install.conf ]]; then
  _CONF="/etc/circuit-breaker/install.conf"
fi

# ── Colors ────────────────────────────────────────────────────────────────────
R='\e[0m'
G='\e[38;5;154m'
B='\e[1m'
GR='\e[90m'
Y='\e[33m'
RED='\e[91m'
LINE=" ${G}─────────────────────────────────────────${R}"

_ok()   { echo -e "${GR}[${R}${G} OK ${R}${GR}]${R} $*"; }
_info() { echo -e "${GR}[${R}${G} INFO ${R}${GR}]${R} $*"; }
_warn() { echo -e "${GR}[${R}${Y}NOTICE${R}${GR}]${R} $*"; }
_fail() { echo -e "${GR}[${R}${RED}ERROR${R}${GR}]${R} $*" >&2; exit 1; }

# ── Defaults — overridden by install.conf ─────────────────────────────────────
CB_MODE="docker"
CB_CONTAINER="circuit-breaker"   # primary/app container (single-container or compose backend)
CB_VOLUME="circuit-breaker-data"
CB_PORT="8080"
CB_IMAGE="ghcr.io/blkleg/circuitbreaker:latest"
# CB_BACKEND_CONTAINER: container that runs Python/the vault code.
#   docker  → same as CB_CONTAINER
#   compose → cb-backend
CB_BACKEND_CONTAINER=""
# CB_DATA_DIR: path to the data directory INSIDE the backend container.
#   docker  → /data
#   compose → /app/data
CB_DATA_DIR=""
# CB_INSTALL_DIR, CB_COMPOSE_FILE: for compose mode (cb update, uninstall)
CB_INSTALL_DIR=""
CB_COMPOSE_FILE=""

if [[ -f "$_CONF" ]]; then
  # shellcheck source=/dev/null
  source "$_CONF"
else
  _warn "Install config not found at $_CONF — using defaults."
fi

# Apply mode-specific defaults for values not set in install.conf
if [[ -z "$CB_BACKEND_CONTAINER" ]]; then
  [[ "$CB_MODE" == "compose" ]] && CB_BACKEND_CONTAINER="cb-backend" || CB_BACKEND_CONTAINER="$CB_CONTAINER"
fi
if [[ -z "$CB_DATA_DIR" ]]; then
  [[ "$CB_MODE" == "compose" ]] && CB_DATA_DIR="/app/data" || CB_DATA_DIR="/data"
fi
# The environment file the *binary* (deb/rpm/apk) install actually gets.
# packaging/postinstall.sh generates circuit-breaker.env, not env, and both
# packaging/circuit-breaker.service and packaging/systemd/circuit-breaker-native.service
# carry `EnvironmentFile=-/etc/circuit-breaker/circuit-breaker.env`. This name is
# defined once, here, because every time it was spelled out at its four call
# sites one of them drifted back to the path nothing creates.
CB_BINARY_ENV_FILE="${CB_BINARY_ENV_FILE:-/etc/circuit-breaker/circuit-breaker.env}"
# The binary a package install puts on the host. Named once for the same reason
# as the env file above: it is invoked from three commands, and an unguarded
# invocation of a path that is not there is what produced a raw bash
# "No such file or directory" and exit 127 instead of an operator-readable error.
CB_BINARY="${CB_BINARY:-/usr/local/bin/circuit-breaker}"

# ── Internal helpers ──────────────────────────────────────────────────────────
_require_docker() {
  command -v docker >/dev/null 2>&1 || _fail "Docker is not installed or not in PATH."
  docker info >/dev/null 2>&1       || _fail "Docker daemon is not running."
}

# Binary-mode counterpart to _require_docker: refuse to exec a fixed path that
# is not there. Without it the operator sees bash's own
# "line NNN: /usr/local/bin/circuit-breaker: No such file or directory" and exit
# 127; the docker branches already fail with a sentence and exit 1, and this
# makes the binary branches match.
_require_binary() {
  local path="$1" why="${2:-}"
  [[ -e "$path" ]] || _fail "${path} not found${why:+ — $why}"
  [[ -x "$path" ]] || _fail "${path} is not executable${why:+ — $why}"
}

# Preflight for binary mode: the snapshot builder shells out to pg_dump, which
# a package install does not pull in. Without this the operator gets a Python
# traceback ending in FileNotFoundError instead of the one sentence that names
# the package to install. The container images already ship the client, so the
# docker/compose paths do not need it.
_require_postgres_client() {
  command -v pg_dump >/dev/null 2>&1 \
    || _fail "pg_dump is not installed on this host — install the PostgreSQL client package (postgresql-client) and retry."
}

_container_running() {
  local name="${1:-$CB_CONTAINER}"
  docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${name}$"
}

# Generate a valid Fernet key using openssl (available on virtually every Linux/macOS host).
_gen_fernet_key() {
  command -v openssl >/dev/null 2>&1 \
    || _fail "openssl is required to generate a vault key. Install it and retry."
  openssl rand -base64 32
}

# A snippet run *inside* the backend container that resolves the database
# connection the way the app does and leaves it in "$@" for psql/pg_dump.
# Compose passes CB_DB_URL into the backend container; the mono image builds
# its URL at entrypoint time, so `docker exec` there only ever sees
# CB_DB_PASSWORD and the connection has to be rebuilt from it.
_DB_CONN_SH='if [ -n "${CB_DB_URL:-}" ]; then set -- "$CB_DB_URL"; else export PGPASSWORD="${CB_DB_PASSWORD:-}"; set -- -h 127.0.0.1 -p 5432 -U breaker circuitbreaker; fi'

# Every application program docker/supervisord.mono.conf defines, by the name it
# actually defines — the whole list, because anything left out keeps writing to the
# database while the schema is being replaced. `backend workers` used to stand here and
# named nothing at all; supervisorctl said so and `2>/dev/null` ate the sentence.
# `worker-monitor-poll` runs numprocs=2, which makes the bare name a *group*: a bare
# `stop worker-monitor-poll` is an error, `worker-monitor-poll:*` is the two processes.
# The datastores (postgres, pgbouncer, nats, redis) and nginx are deliberately absent —
# Postgres is what is being restored into.
# tests/services/test_restore_targets.py fails if this drifts from the config again.
#
# `-c` is not optional. entrypoint-mono.sh launches supervisord with
# `-c /etc/supervisor/conf.d/supervisord.conf`, while a bare `supervisorctl` searches its
# own path and finds Debian's /etc/supervisor/supervisord.conf first — a different file,
# pointing at a socket nothing is listening on.
_CB_SUPERVISORCTL=(supervisorctl -c /etc/supervisor/conf.d/supervisord.conf)
_CB_APP_PROGRAMS=(
  backend-api
  worker-discovery
  worker-notification
  worker-telemetry
  worker-monitor-scheduler
  'worker-monitor-poll:*'
  worker-monitor-probe-dispatch
)

###############################################################################
# COMMANDS
###############################################################################

cmd_status() {
  echo ""
  echo -e "$LINE"
  echo -e " ${B}Circuit Breaker — Status${R}"
  echo -e "$LINE"
  echo ""

  case "$CB_MODE" in
    docker)
      _require_docker
      if _container_running; then
        _ok "Container '${CB_CONTAINER}' is running."
        docker inspect --format \
          "  Image   : {{.Config.Image}}
  Started : {{.State.StartedAt}}
  Status  : {{.State.Status}}" \
          "$CB_CONTAINER" 2>/dev/null || true
        echo ""
        echo -e "  ${GR}Access :${R} http://localhost:${CB_PORT}"
      else
        _warn "Container '${CB_CONTAINER}' is not running."
      fi
      ;;
    compose)
      _require_docker
      echo -e "  ${GR}Compose stack containers:${R}"
      echo ""
      docker ps --filter "name=cb-" \
        --format "  {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null \
        | column -t || true
      ;;
    binary)
      if command -v systemctl >/dev/null 2>&1; then
        systemctl status circuit-breaker --no-pager -l || true
      else
        _warn "systemctl not found — cannot query service status."
      fi
      ;;
  esac
  echo ""
}

# ── doctor ────────────────────────────────────────────────────────────────────
# The same top-down health check the native CLI runs, expressed for the
# container world.  Checks are ordered so that the first failure is usually the
# cause of every failure below it — fix top-down.
cmd_doctor() {
  echo ""
  echo -e "$LINE"
  echo -e " ${B}Circuit Breaker — Health Check${R}"
  echo -e "$LINE"
  echo ""

  local failed=0
  local diag_lines="${CB_DOCTOR_LINES:-30}"

  # $4 is an optional read-only diagnostic, run only when the check fails.  A
  # failed check otherwise just sends the operator off to run a `docker logs`
  # line by hand — the reason is in those lines, so print them here instead.
  # Read-only only: repair commands stay in the hint for a human to run.
  check() {
    local name=$1 cmd=$2 hint=$3 diag=${4:-}
    if eval "$cmd" &>/dev/null; then
      printf "  ${G}✓${R}  %-30s OK\n" "$name"
    else
      printf "  ${RED}✗${R}  %-30s FAILED\n" "$name"
      echo "     → $hint"
      if [[ -n "$diag" ]]; then
        local out=""
        # A diagnostic that itself fails still tells us something, and `set -e`
        # must not take the whole run down over it.
        out="$(eval "$diag" 2>&1 | tail -n "$diag_lines")" || true
        if [[ -n "$out" ]]; then
          printf "     ${GR}\$ %s${R}\n" "$diag"
          printf '%s\n' "$out" | sed 's/^/       /'
        fi
      fi
      failed=$((failed + 1))
    fi
  }

  case "$CB_MODE" in
    docker|compose)
      local ctr="$CB_BACKEND_CONTAINER" api_port=8080
      # The mono image serves the API behind its own nginx on 8080; the compose
      # backend container listens on 8000 directly.
      if [[ "$CB_MODE" == "compose" ]]; then api_port=8000; fi

      if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
        printf "  ${RED}✗${R}  %-30s FAILED\n" "Docker daemon"
        echo "     → Install Docker, or start it: sudo systemctl start docker"
        echo ""
        echo -e "  ${Y}1 check failed.${R} Everything below runs through the daemon — nothing else can be checked."
        echo ""
        return 1
      fi
      printf "  ${G}✓${R}  %-30s OK\n" "Docker daemon"

      check "Container '${ctr}'" \
            "_container_running '${ctr}'" \
            "Start it: cb restart   (or: docker start ${ctr})" \
            "docker ps -a --filter 'name=^/${ctr}\$' --format '{{.Names}}  {{.Status}}'"

      if _container_running "$ctr"; then
        check "Container not restarting" \
              "[[ \$(docker inspect -f '{{.State.Restarting}}' '${ctr}') == false ]]" \
              "The container is crash-looping — the reason is in its own logs." \
              "docker logs --tail 30 '${ctr}'"

        check "Backend API (:${api_port})" \
              "docker exec '${ctr}' curl -sf 'http://127.0.0.1:${api_port}/api/v1/health'" \
              "The app is not answering inside the container." \
              "docker logs --tail 30 '${ctr}'"

        # A DB probe run the way the app connects: compose passes CB_DB_URL into
        # the backend container, while the mono image builds its URL at
        # entrypoint time, so `docker exec` there only ever sees CB_DB_PASSWORD.
        local db_ok=1
        docker exec "$ctr" sh -c "${_DB_CONN_SH}; exec psql \"\$@\" -tAc 'SELECT 1'" >/dev/null 2>&1 || db_ok=0
        check "Database" \
              "[[ $db_ok -eq 1 ]]" \
              "Postgres is not accepting the app's credentials — check CB_DB_PASSWORD / CB_DB_URL." \
              "docker logs --tail 30 '${ctr}'"

        # Postgres, the WAL and uploads all share the data volume; it filling up
        # takes the whole stack down and shows up nowhere else until it does.
        local free_kb
        free_kb=$(docker exec "$ctr" df -Pk "$CB_DATA_DIR" 2>/dev/null | awk 'NR==2 {print $4}')
        check "Free space on ${CB_DATA_DIR}" \
              "[[ ${free_kb:-0} -ge 1048576 ]]" \
              "Under 1 GiB free on the data volume — prune old backups or grow the volume." \
              "docker exec '${ctr}' df -h '${CB_DATA_DIR}'"

        # An ephemeral vault (no persisted key) survives a restart looking fine
        # and then cannot decrypt anything stored before it — see cb vault-recover.
        check "Vault key persisted" \
              "docker exec '${ctr}' sh -c '[ -n \"\$CB_VAULT_KEY\" ] || grep -qs \"^CB_VAULT_KEY=\" \"${CB_DATA_DIR}/.env\"'" \
              "No persisted vault key — run: cb vault-recover"
      fi

      # The published port is the only thing an actual user touches; a healthy
      # container behind a port that never got published still looks broken.
      check "Published port :${CB_PORT}" \
            "curl -sf --max-time 5 'http://127.0.0.1:${CB_PORT}/api/v1/health' -o /dev/null" \
            "Nothing answers on localhost:${CB_PORT} — check the port mapping and any host firewall." \
            "docker port '${CB_CONTAINER}'"
      ;;

    binary)
      check "systemd unit" \
            "systemctl is-active --quiet circuit-breaker" \
            "Start it: sudo systemctl start circuit-breaker" \
            "systemctl status circuit-breaker --no-pager -l | tail -n 5; journalctl -u circuit-breaker --no-pager -n 30"

      check "Backend API (:${CB_PORT})" \
            "curl -sf --max-time 5 'http://127.0.0.1:${CB_PORT}/api/v1/health' -o /dev/null" \
            "The service is not answering on port ${CB_PORT}." \
            "journalctl -u circuit-breaker --no-pager -n 30"

      # Read the service's own environment file rather than guessing: it is the
      # only place the data directory and DB credentials are recorded.
      local env_file="$CB_BINARY_ENV_FILE" data_dir="/var/lib/circuit-breaker" db_url=""
      if [[ -r "$env_file" ]]; then
        data_dir=$(sed -n 's/^CB_DATA_DIR=//p' "$env_file" | tail -n1 | tr -d '"')
        data_dir="${data_dir:-/var/lib/circuit-breaker}"
        db_url=$(sed -n 's/^CB_DB_URL=//p' "$env_file" | tail -n1 | tr -d '"')
      else
        _warn "Cannot read ${env_file} — data directory and database checks may be skipped. Try: sudo cb doctor"
      fi

      if [[ -d "$data_dir" ]]; then
        local free_kb
        free_kb=$(df -Pk "$data_dir" 2>/dev/null | awk 'NR==2 {print $4}')
        check "Free space on ${data_dir}" \
              "[[ ${free_kb:-0} -ge 1048576 ]]" \
              "Under 1 GiB free on the data directory — prune old backups or grow the filesystem." \
              "df -h '${data_dir}'"
      fi

      if [[ -n "$db_url" ]]; then
        if command -v psql >/dev/null 2>&1; then
          local db_ok=1
          psql "$db_url" -tAc 'SELECT 1' >/dev/null 2>&1 || db_ok=0
          check "Database" \
                "[[ $db_ok -eq 1 ]]" \
                "Postgres is not accepting CB_DB_URL from ${env_file}."
        else
          _info "psql not installed — skipping the database check."
        fi
      fi
      ;;
  esac

  echo ""
  if [[ $failed -eq 0 ]]; then
    _ok "All checks passed."
  else
    echo -e "  ${Y}${failed} check(s) failed.${R} Fix top-down — each layer depends on the one above."
  fi
  echo ""
  [[ $failed -eq 0 ]]
}

cmd_logs() {
  local follow=""
  [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]] && follow="-f"

  case "$CB_MODE" in
    docker)
      _require_docker
      # shellcheck disable=SC2086
      docker logs $follow --tail 100 "$CB_CONTAINER"
      ;;
    compose)
      _require_docker
      # Show backend logs; most relevant for app-level debugging
      # shellcheck disable=SC2086
      docker logs $follow --tail 100 "$CB_BACKEND_CONTAINER"
      ;;
    binary)
      command -v journalctl >/dev/null 2>&1 \
        || _fail "journalctl not found."
      # shellcheck disable=SC2086
      journalctl -u circuit-breaker --no-pager $follow -n 100
      ;;
  esac
}

cmd_restart() {
  case "$CB_MODE" in
    docker)
      _require_docker
      _info "Restarting container '${CB_CONTAINER}'..."
      docker restart "$CB_CONTAINER"
      _ok "Restarted."
      ;;
    compose)
      _require_docker
      _info "Restarting compose stack containers..."
      for svc in cb-backend cb-frontend cb-caddy; do
        docker restart "$svc" 2>/dev/null && _ok "Restarted $svc." || _warn "$svc not running — skipped."
      done
      ;;
    binary)
      _info "Restarting systemd service..."
      sudo systemctl restart circuit-breaker
      _ok "Restarted."
      ;;
  esac
}

cmd_update() {
  case "$CB_MODE" in
    docker)
      _require_docker
      _info "Pulling latest image: ${CB_IMAGE}"
      docker pull "$CB_IMAGE"

      # Refuse before anything is destroyed, not after. An operator who created
      # this container with `docker run -e CB_JWT_SECRET=... -e NATS_AUTH_TOKEN=...`
      # keeps those values in one place only: the container's own config, which
      # `docker rm` deletes. Recreating without --env-file therefore hands the
      # replacement none of the secrets docker/entrypoint-mono.sh refuses to
      # start without, and none of CB_VAULT_KEY/CB_DB_PASSWORD either — a restart
      # loop with the old container already gone, which is the one outcome an
      # upgrade must never produce. `~/.circuit-breaker/env` is operator-supplied
      # (no installer writes it, see docs/cb-cli.md), so its absence is a real
      # possibility rather than a theoretical one.
      local env_args=()
      if [[ -f "$CB_CONFIG_DIR/env" ]]; then
        env_args=(--env-file "$CB_CONFIG_DIR/env")
      else
        _fail "$(printf '%s\n' \
          "No environment file at ${CB_CONFIG_DIR}/env — refusing to recreate '${CB_CONTAINER}'." \
          "  Recreating discards the environment this container was created with, and the" \
          "  replacement would start without CB_JWT_SECRET, CB_VAULT_KEY, CB_DB_PASSWORD and" \
          "  NATS_AUTH_TOKEN and exit FATAL." \
          "  Write that file with the values this container was created with (see docs/cb-cli.md)," \
          "  or upgrade by re-running your original 'docker run'. Nothing has been changed.")"
      fi

      # Renamed rather than removed: the old container is the rollback, and it
      # costs nothing to keep until the new one has proved it serves. A leftover
      # -prev from an upgrade the operator never finished would block the rename,
      # so it goes first.
      local prev="${CB_CONTAINER}-prev"
      docker rm -f "$prev" >/dev/null 2>&1 || true

      _info "Recreating container '${CB_CONTAINER}'..."
      docker stop "$CB_CONTAINER" >/dev/null 2>&1 || true
      docker rename "$CB_CONTAINER" "$prev" 2>/dev/null \
        || docker rm "$CB_CONTAINER" 2>/dev/null || true

      docker run -d \
        --name  "$CB_CONTAINER" \
        "${env_args[@]}" \
        -p      "${CB_PORT}:8080" \
        -v      "${CB_VOLUME}:/data" \
        --restart unless-stopped \
        "$CB_IMAGE" \
        || _fail "Failed to start the updated container. The previous one is still here — roll back with: docker rm ${CB_CONTAINER} && docker rename ${prev} ${CB_CONTAINER} && docker start ${CB_CONTAINER}"

      # `docker run -d` exits 0 as soon as the container is *created*. The secret
      # validation, the migration and every supervised program come after that,
      # so its exit code says nothing about whether this install came back — and
      # printing "Updated and restarted." over a crash loop is how an upgrade
      # failure stays invisible until someone opens the UI. Ask the application,
      # the same way the restore path does.
      if ! command -v curl >/dev/null 2>&1; then
        _ok "Updated and restarted."
        _warn "curl is not installed, so the health check was skipped — verify with: cb status"
        _warn "The previous container is kept as '${prev}'; remove it once you are satisfied: docker rm ${prev}"
        return 0
      fi

      _info "Waiting for the application to come back…"
      local tries=0
      until curl -fsS "http://127.0.0.1:${CB_PORT:-8080}/api/v1/livez" >/dev/null 2>&1; do
        tries=$((tries + 1))
        [[ $tries -gt 60 ]] && _fail "$(printf '%s\n' \
          "Updated, but the application did not become healthy. Check: cb logs" \
          "  The container that was serving before the upgrade is still here as '${prev}'. Roll back with:" \
          "    docker rm -f ${CB_CONTAINER} && docker rename ${prev} ${CB_CONTAINER} && docker start ${CB_CONTAINER}")"
        sleep 2
      done

      docker rm "$prev" >/dev/null 2>&1 || true
      _ok "Updated and restarted."
      ;;
    compose)
      _require_docker
      local dir="${CB_INSTALL_DIR:-$HOME/.circuit-breaker}"
      local compose_file="${CB_COMPOSE_FILE:-$dir/docker-compose.prod.yml}"
      if [[ ! -f "$compose_file" ]]; then
        _fail "Compose file not found at $compose_file. Set CB_INSTALL_DIR or CB_COMPOSE_FILE in install.conf."
      fi
      _info "Pulling latest images..."
      (cd "$(dirname "$compose_file")" && docker compose -f "$(basename "$compose_file")" pull)
      _info "Recreating stack..."
      (cd "$(dirname "$compose_file")" && docker compose -f "$(basename "$compose_file")" up -d)
      _ok "Updated and restarted."
      ;;
    binary)
      _fail "'cb update' is not supported for binary installs. Re-run install.sh to upgrade."
      ;;
  esac
}

# ── backup ────────────────────────────────────────────────────────────────────
# One artifact, one builder.  `cb backup` produces the full-state snapshot —
# db.sql.gz, uploads/, config/, vault.key and manifest.json — which is exactly
# what POST /admin/db/snapshot and the nightly scheduled job produce, because
# all three call services/backup/snapshot.py through the same CLI.
#
# It used to build its own archive here in bash (database.sql + manifest.txt, no
# uploads, no vault key).  deploy/scripts/restore.sh structurally rejected that
# shape, so every `cb backup` archive was unrestorable by the tool documented to
# restore it (INC-15).  Do not reintroduce a second builder: extend
# services/backup/snapshot.py and every caller gets it.
cmd_backup() {
  local backup_dir out
  backup_dir="${CB_BACKUP_DIR:-$CB_CONFIG_DIR/backups}"
  mkdir -p "$backup_dir" || _fail "Cannot create backup directory $backup_dir."

  case "$CB_MODE" in
    docker|compose)
      _require_docker
      _container_running "$CB_BACKEND_CONTAINER" \
        || _fail "Container '${CB_BACKEND_CONTAINER}' must be running to take a snapshot. Start it first."

      _info "Building a full-state snapshot inside '${CB_BACKEND_CONTAINER}'…"
      # The snapshot is written inside the container, where the database, the
      # uploads directory and the vault key all are; only the finished archive
      # crosses to the host.
      out=$(docker exec -e "CB_INSTALL_MODE=${CB_MODE}" "$CB_BACKEND_CONTAINER" \
              python -m app.cli snapshot create) \
        || _fail "Snapshot failed — see the output above."
      # The path is the last line: anything the builder logs comes before it.
      out=$(printf '%s\n' "$out" | tail -n1)
      [[ -n "$out" ]] || _fail "Snapshot reported success but printed no path."

      docker cp "${CB_BACKEND_CONTAINER}:${out}" "$backup_dir/" \
        || _fail "Snapshot was created in the container at ${out} but could not be copied to ${backup_dir}."
      docker exec "$CB_BACKEND_CONTAINER" rm -f "$out" 2>/dev/null || true
      out="$backup_dir/$(basename "$out")"
      ;;

    binary)
      _require_postgres_client

      local env_file="$CB_BINARY_ENV_FILE"
      [[ -r "$env_file" ]] \
        || _fail "Cannot read ${env_file} — the database credentials and the vault key live there. Try: sudo cb backup"
      _require_binary "$CB_BINARY" \
        "the snapshot builder ships with the Circuit Breaker binary. Install the package, or set CB_MODE in ${_CONF} to the mode this host actually runs."

      _info "Building a full-state snapshot…"
      # The unit's environment is loaded in a subshell, so CB_VAULT_KEY and the
      # database credentials reach the builder without leaking into the rest of
      # this process.
      # shellcheck source=/dev/null
      out=$(set -a; . "$env_file"; set +a
            CB_INSTALL_MODE=binary "$CB_BINARY" --snapshot-create --out "$backup_dir") \
        || _fail "Snapshot failed — see the output above."
      out=$(printf '%s\n' "$out" | tail -n1)
      [[ -n "$out" ]] || _fail "Snapshot reported success but printed no path."
      ;;

    *) _fail "Unknown mode '${CB_MODE}'." ;;
  esac

  [[ -s "$out" ]] || _fail "Expected a snapshot at ${out}, but nothing usable is there."
  chmod 600 "$out" 2>/dev/null || true

  _ok "Backup written to ${out}"
  echo -e "  ${GR}Contains the database, uploads, config and the vault key.${R}"
  echo -e "  ${Y}The vault key is stored in plaintext — this file is mode 0600, treat it as a secret.${R}"
  echo -e "  ${GR}Restore with: cb restore ${out}${R}"
}

# ── restore ───────────────────────────────────────────────────────────────────
# Destructive. Replaces the database, the uploads and the vault key.
#
# The ordering below is the safety property, not a style choice:
#   verify → confirm → safety snapshot → stop → restore → start → verify
# Nothing is stopped until the archive has been verified, and nothing is
# destroyed until a safety snapshot of the current state exists. INC-15 was an
# archive that could not be restored by the tool documented to restore it; an
# operator who discovers that *after* the service is down has an outage instead
# of a failed command.
cmd_restore() {
  local archive="${1:-}" force="" assume_yes="" safety="1" arg
  [[ -n "$archive" && "$archive" != -* ]] \
    || _fail "Usage: cb restore <archive.tar.gz> [--yes] [--force] [--no-safety-snapshot]"
  [[ -f "$archive" ]] || _fail "Snapshot file not found: $archive"

  for arg in "$@"; do
    case "$arg" in
      --yes) assume_yes=1 ;;
      --force) force=1 ;;
      --no-safety-snapshot) safety="" ;;
    esac
  done

  # ── 1. Verify before touching anything ──────────────────────────────────
  # The verifier is services/backup/verify.py, reached through the same CLI in
  # every mode, so all three refuse an unrestorable archive with one sentence.
  # --force clears CB_VERSION for that call: the only guard it can bypass is
  # the "this snapshot is newer than the installed build" refusal, which is
  # exactly what the verifier's own message offers --force for.
  _info "Verifying ${archive}…"
  local manifest
  case "$CB_MODE" in
    docker|compose)
      _require_docker
      _container_running "$CB_BACKEND_CONTAINER" \
        || _fail "Container '${CB_BACKEND_CONTAINER}' must be running to verify the archive. Start it first."
      # Staged on the data volume, not in /tmp: /tmp is a 100 MB tmpfs in the
      # shipped mono container (docker-compose.yml), and the archive, the tree it
      # unpacks to and the uncompressed db.sql all land here — a real snapshot
      # fills that tmpfs and the restore dies partway through unpacking. Only the
      # mono entrypoint creates ${CB_DATA_DIR}/tmp, so the compose backend needs
      # it made before anything is copied into it.
      docker exec -e "CB_DATA_DIR=${CB_DATA_DIR}" "$CB_BACKEND_CONTAINER" \
        sh -c 'mkdir -p "${CB_DATA_DIR}/tmp"' \
        || _fail "Could not create the staging directory ${CB_DATA_DIR}/tmp inside '${CB_BACKEND_CONTAINER}'."
      docker cp "$archive" "${CB_BACKEND_CONTAINER}:${CB_DATA_DIR}/tmp/cb-restore.tar.gz" \
        || _fail "Could not copy the archive into '${CB_BACKEND_CONTAINER}'."
      local -a vopts=()
      [[ -n "$force" ]] && vopts+=(-e "CB_VERSION=")
      manifest=$(docker exec "${vopts[@]}" "$CB_BACKEND_CONTAINER" \
                   python -m app.cli snapshot verify "${CB_DATA_DIR}/tmp/cb-restore.tar.gz") \
        || _fail "This archive cannot be restored — see the reason above."
      ;;
    binary)
      # No `python -m app.cli` on a packaged install; the frozen binary is the
      # whole of Python there, exactly as in cmd_config and cmd_backup.
      _require_binary "$CB_BINARY" \
        "the snapshot verifier ships with the Circuit Breaker binary. \`binary\` mode is the deb/rpm/apk layout; an install.sh-native host keeps its binary at /opt/circuitbreaker/bin/circuit-breaker and has its own cb. Install the package, or set CB_MODE in ${_CONF} to the mode this host actually runs."
      if [[ -n "$force" ]]; then
        manifest=$(CB_VERSION= "$CB_BINARY" --snapshot-verify "$archive") \
          || _fail "This archive cannot be restored — see the reason above."
      else
        manifest=$("$CB_BINARY" --snapshot-verify "$archive") \
          || _fail "This archive cannot be restored — see the reason above."
      fi
      ;;
    *) _fail "Unknown mode '${CB_MODE}'." ;;
  esac

  # ── 2. Confirm against the archive's identity, not its filename ─────────
  echo ""
  echo -e "  ${B}This will REPLACE the database, uploads and vault key of this install.${R}"
  echo "$manifest" | sed 's/^/  /'
  echo ""
  if [[ -z "$assume_yes" ]]; then
    echo -en "  Type ${B}RESTORE${R} to proceed: "
    local reply; read -r reply < /dev/tty
    [[ "$reply" == "RESTORE" ]] || _fail "Aborted — nothing was changed."
  fi

  # ── 3. Safety snapshot ──────────────────────────────────────────────────
  if [[ -n "$safety" ]]; then
    _info "Taking a safety snapshot of the current state first…"
    cmd_backup || _fail "Safety snapshot failed — refusing to restore. Re-run with --no-safety-snapshot to skip."
  fi

  # ── 4-8. Mode-specific restore ──────────────────────────────────────────
  case "$CB_MODE" in
    docker|compose) _restore_container "$archive" ;;
    binary)         _restore_binary "$archive" ;;
  esac

  # ── 9. Verify the result ────────────────────────────────────────────────
  # Without curl the loop below would spin for two minutes and then report a
  # healthy restore as a failure, which is the worst of both.
  if ! command -v curl >/dev/null 2>&1; then
    _ok "Restore complete."
    _warn "curl is not installed, so the health check was skipped — verify with: cb status"
    return 0
  fi

  _info "Waiting for the application to come back…"
  local tries=0
  until curl -fsS "http://127.0.0.1:${CB_PORT:-8080}/api/v1/livez" >/dev/null 2>&1; do
    tries=$((tries + 1))
    [[ $tries -gt 60 ]] && _fail "Restored, but the application did not become healthy. Check: cb logs"
    sleep 2
  done

  _ok "Restore complete and the application is healthy."
  echo -e "  ${GR}Confirm the vault decrypts by opening a page with stored credentials (Settings → SMTP).${R}"
}

# Postgres runs inside the mono container under supervisord, so the application
# programs are stopped and the database is left up — it is the thing being
# restored into.
_restore_container() {
  local archive="$1"

  # A restore that runs under live writers is not a restore. Nothing has been destroyed
  # at this point — the archive is verified and the safety snapshot is taken — so a stop
  # that did not happen is a reason to abort, not a reason to warn.
  _info "Stopping application processes (database stays up)…"
  local stop_out=""
  stop_out=$(docker exec "$CB_BACKEND_CONTAINER" \
               "${_CB_SUPERVISORCTL[@]}" stop "${_CB_APP_PROGRAMS[@]}" 2>&1) || true
  printf '%s\n' "$stop_out" | sed 's/^/    /'

  # The verdict is the resulting state, not the exit code: `supervisorctl stop` exits
  # non-zero for "ERROR (not running)" as well, which is the state this step is trying to
  # reach. Reading the state back also catches the two failures that hid here before — a
  # program name nothing defines, and a supervisord with no control socket to answer on —
  # because neither can produce a status line for a stopped program.
  local status_out="" unstopped=""
  status_out=$(docker exec "$CB_BACKEND_CONTAINER" \
                 "${_CB_SUPERVISORCTL[@]}" status "${_CB_APP_PROGRAMS[@]}" 2>&1) || true
  unstopped=$(printf '%s\n' "$status_out" \
              | grep -Ev 'STOPPED|EXITED|FATAL|BACKOFF|not running' \
              | grep -v '^[[:space:]]*$' || true)
  if [[ -z "$status_out" || -n "$unstopped" ]]; then
    printf '%s\n' "${unstopped:-supervisorctl produced no status output at all}" \
      | sed 's/^/    /' >&2
    _fail "$(printf '%s\n' \
      "Could not confirm the application is stopped inside '${CB_BACKEND_CONTAINER}' — refusing to restore." \
      "  Replaying a dump while the API and the workers hold connections corrupts the result." \
      "  The database has not been touched. Check the lines above, then retry." \
      "  Inspect by hand:  docker exec ${CB_BACKEND_CONTAINER} ${_CB_SUPERVISORCTL[*]} status")"
  fi

  _info "Restoring the database…"
  # The archive is already inside the container: step 1 copied it there to verify it.
  docker exec -e "CB_DATA_DIR=${CB_DATA_DIR}" "$CB_BACKEND_CONTAINER" sh -c '
    set -e
    stage="${CB_DATA_DIR}/tmp/cb-restore"
    rm -rf "$stage" && mkdir -p "$stage"
    tar -xzf "${stage}.tar.gz" -C "$stage" --strip-components=1
    gunzip -c "$stage/db.sql.gz" > "$stage/db.sql"
  ' || _fail "Could not unpack the archive inside the container."

  docker exec "$CB_BACKEND_CONTAINER" sh -c "${_DB_CONN_SH}; exec psql \"\$@\" -v ON_ERROR_STOP=1 -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'" \
    || _fail "Could not reset the database schema. The safety snapshot is in your backup directory."

  docker exec "$CB_BACKEND_CONTAINER" sh -c "${_DB_CONN_SH}; exec psql \"\$@\" -v ON_ERROR_STOP=1 -f ${CB_DATA_DIR}/tmp/cb-restore/db.sql" \
    || _fail "Database restore failed. The safety snapshot is in your backup directory."

  _info "Restoring uploads…"
  docker exec -e "CB_DATA_DIR=${CB_DATA_DIR}" "$CB_BACKEND_CONTAINER" sh -c '
    set -e
    if [ -d "${CB_DATA_DIR}/tmp/cb-restore/uploads" ]; then
      mkdir -p "${CB_DATA_DIR}/uploads"
      rm -rf "${CB_DATA_DIR}/uploads.old"
      cp -a "${CB_DATA_DIR}/uploads" "${CB_DATA_DIR}/uploads.old" 2>/dev/null || true
      rm -rf "${CB_DATA_DIR}/uploads"/*
      cp -a "${CB_DATA_DIR}/tmp/cb-restore/uploads/." "${CB_DATA_DIR}/uploads/"
    fi
  ' || _fail "Uploads restore failed."

  _info "Restoring the vault key…"
  docker exec -e "CB_DATA_DIR=${CB_DATA_DIR}" "$CB_BACKEND_CONTAINER" sh -c '
    set -e
    key=$(cat "${CB_DATA_DIR}/tmp/cb-restore/vault.key")
    [ -n "$key" ] || { echo "vault.key in the archive is empty" >&2; exit 1; }
    env_file="${CB_DATA_DIR}/.env"
    mkdir -p "${CB_DATA_DIR}"
    touch "$env_file"
    if grep -q "^CB_VAULT_KEY=" "$env_file"; then
      sed -i "s|^CB_VAULT_KEY=.*|CB_VAULT_KEY=${key}|" "$env_file"
    else
      echo "CB_VAULT_KEY=${key}" >> "$env_file"
    fi
    chmod 600 "$env_file"
  ' || _fail "Vault key restore failed — the database is restored but credentials will not decrypt."

  docker exec -e "CB_DATA_DIR=${CB_DATA_DIR}" "$CB_BACKEND_CONTAINER" \
    sh -c 'rm -rf "${CB_DATA_DIR}/tmp/cb-restore" "${CB_DATA_DIR}/tmp/cb-restore.tar.gz"' 2>/dev/null || true

  # Restarted rather than `supervisorctl start`ed: the vault key changed in the
  # environment file, and the application reads it at process start.
  _info "Restarting…"
  docker restart "$CB_BACKEND_CONTAINER" >/dev/null \
    || _fail "Restore finished but the container did not restart. Start it manually: docker start ${CB_BACKEND_CONTAINER}"
}

# deploy/scripts/restore.sh already restores a native install correctly — database,
# uploads, vault key, nginx site config — so the binary branch drives it rather than
# growing a second implementation beside it.
#
# It is written for the `install.sh` native layout, and this `cb`'s `binary` mode is the
# other one: the distro package (packaging/README.md). Those two layouts share no paths,
# so the script is *told* which one it is on rather than left to assume. Without that it
# stopped circuitbreaker.target (absent here, and `|| true`, so nothing stopped while the
# database was dropped), recreated the database as roles a package host does not have,
# and wrote CB_VAULT_KEY into /etc/circuitbreaker/.env — which packaging/circuit-breaker.
# service does not read — so a restore reported success and left every encrypted column
# unreadable.
#
# The values below are the packaged layout, from one source each:
#   CB_ENV_FILE      $CB_BINARY_ENV_FILE, the file the unit's EnvironmentFile= names
#   CB_SERVICE_UNIT  packaging/circuit-breaker.service
#   CB_DB_OWNER      the role in the CB_DB_URL packaging/postinstall.sh generates
# An install.sh-native host is not this mode: it has its own `cb` (deploy/cli/cb) and its
# own paths, and `cb restore` there refuses at the verify step because
# /usr/local/bin/circuit-breaker does not exist on it.
_restore_binary() {
  local archive="$1" script="" candidate here
  here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)

  # No installer copies restore.sh onto the host today (nfpm.yaml ships the binary,
  # not deploy/), so the checkout next to this script is the case that actually
  # happens. CB_RESTORE_SCRIPT in install.conf overrides all of it.
  for candidate in \
    "${CB_RESTORE_SCRIPT:-}" \
    "${CB_INSTALL_DIR:+${CB_INSTALL_DIR}/deploy/scripts/restore.sh}" \
    "${here}/deploy/scripts/restore.sh" \
    "/opt/circuitbreaker/deploy/scripts/restore.sh"
  do
    [[ -n "$candidate" && -f "$candidate" ]] && { script="$candidate"; break; }
  done

  [[ -n "$script" ]] || _fail "$(printf '%s\n' \
    "Restore script not found. It ships in the repository, not in the package." \
    "  Get it:  git clone https://github.com/BlkLeg/circuitbreaker" \
    "  Then:    CB_RESTORE_SCRIPT=<checkout>/deploy/scripts/restore.sh cb restore ${archive}")"
  [[ -x "$script" ]] || _fail "${script} is not executable — chmod +x it and retry."

  # cb has already verified the archive and taken the operator's confirmation;
  # restore.sh asks for its own. Answering it here keeps `cb restore --yes`
  # non-interactive instead of blocking on a prompt nobody is watching.
  printf 'y\n' | \
    CB_ENV_FILE="$CB_BINARY_ENV_FILE" \
    CB_SERVICE_UNIT="${CB_SERVICE_UNIT:-circuit-breaker.service}" \
    CB_DB_NAME="${CB_DB_NAME:-circuitbreaker}" \
    CB_DB_OWNER="${CB_DB_OWNER:-circuitbreaker}" \
    CB_DB_SUPERUSER="${CB_DB_SUPERUSER:-postgres}" \
    "$script" "$archive" \
    || _fail "Restore failed — see the output above."
}

# ── admin command surface ─────────────────────────────────────────────────────
# `migrate`, `token`, `user` and `agent` are one Python command surface
# (apps/backend/src/app/cli.py) reached three ways, exactly as `cb config
# validate` and `cb backup` already are: through `python -m app.cli` in a
# container, and through the frozen binary on a package install, which has no
# Python of its own.
#
# There is deliberately no bash implementation of any of them. Approving an
# agent means writing capability grants and an agent_events row; minting a
# token means hashing it the way the verifier hashes it. A shell reimplementation
# of either is a second definition of a security rule, which is how INC-15
# happened to the backup format.
#
# `docker exec -i`: `cb user create --password-stdin` reads a password from
# stdin precisely so it never appears in argv, and without -i the pipe does not
# reach the container.
_admin_cli() {
  case "$CB_MODE" in
    docker|compose)
      _require_docker
      _container_running "$CB_BACKEND_CONTAINER" \
        || _fail "Container '${CB_BACKEND_CONTAINER}' must be running — these commands run inside it, where the database is."
      docker exec -i "$CB_BACKEND_CONTAINER" python -m app.cli "$@"
      ;;

    binary)
      # The unit's environment holds the database credentials and the vault key;
      # these commands need both, and cmd_config loads it the same way.
      local env_file="$CB_BINARY_ENV_FILE"
      if [[ -f "$env_file" ]]; then
        set -a
        # shellcheck source=/dev/null
        source "$env_file"
        set +a
      else
        _warn "No ${env_file} — running against the ambient environment only."
      fi
      _require_binary "$CB_BINARY" \
        "the administration commands ship with the Circuit Breaker binary. Install the package, or set CB_MODE in ${_CONF} to the mode this host actually runs."
      "$CB_BINARY" --admin "$@"
      ;;

    *) _fail "Unknown mode '${CB_MODE}'." ;;
  esac
}

# ── migrate ───────────────────────────────────────────────────────────────────
# `status` exits 3 when the database is behind, so a deployment script can tell
# "needs an upgrade" from "cannot reach the database" without parsing prose.
# `upgrade` runs through the server's own upgrade path, which takes the
# transaction-scoped advisory lock in migrations/env.py — so it is safe to run
# while the stack is coming up and racing the API's auto-migrate phase.
cmd_migrate() { _admin_cli migrate "$@"; }

# ── token / user / agent ──────────────────────────────────────────────────────
# Scoped API tokens (create/list/rotate/revoke), local accounts, and the agent
# fleet. Every mutation is written to the audit log with the administrator it
# was attributed to; secrets are printed once, at creation, and never stored in
# readable form.
cmd_token() { _admin_cli token "$@"; }
cmd_user()  { _admin_cli user "$@"; }
cmd_agent() { _admin_cli agent "$@"; }

# ── config ────────────────────────────────────────────────────────────────────
# Runs the backend's own configuration validator, so `cb` never has a second,
# drifting opinion about what a valid configuration is.
cmd_config() {
  local action="${1:-}"
  if [[ "$action" != "validate" ]]; then
    echo "Usage: cb config validate"
    return 2
  fi

  case "$CB_MODE" in
    docker|compose)
      _require_docker
      _container_running "$CB_BACKEND_CONTAINER" \
        || _fail "Container '${CB_BACKEND_CONTAINER}' must be running — the validator runs inside it."
      docker exec "$CB_BACKEND_CONTAINER" python -m app.cli config validate
      ;;
    binary)
      # Load the same environment file the unit does, so the validator sees
      # exactly the configuration the service would start with.
      local env_file="$CB_BINARY_ENV_FILE"
      if [[ -f "$env_file" ]]; then
        set -a
        # shellcheck source=/dev/null
        source "$env_file"
        set +a
      else
        _warn "No ${env_file} — validating the ambient environment only."
      fi
      _require_binary "$CB_BINARY" \
        "the validator ships with the Circuit Breaker binary. Install the package, or set CB_MODE in ${_CONF} to the mode this host actually runs."
      "$CB_BINARY" --config-validate
      ;;
  esac
}

# ── vault-recover ─────────────────────────────────────────────────────────────
# Recovery tool for when the vault is in "ephemeral" state (no key was ever
# persisted).  Under normal operation this is handled automatically by the OOBE
# wizard — you should only need this after a crash, a headless deploy, or if
# the data volume's .env file was accidentally deleted.
cmd_vault_recover() {
  echo ""
  echo -e "$LINE"
  echo -e " ${B}Vault Recovery${R}"
  echo -e "$LINE"
  echo ""
  echo -e "  ${Y}This command is a recovery tool for an uninitialized vault.${R}"
  echo -e "  ${GR}Under normal operation the vault key is generated automatically"
  echo -e "  during the first-run setup wizard (OOBE) — you should not need"
  echo -e "  this unless the vault is stuck in 'ephemeral' state.${R}"
  echo ""

  case "$CB_MODE" in
    docker|compose)
      _require_docker
      _container_running "$CB_BACKEND_CONTAINER" \
        || _fail "Container '${CB_BACKEND_CONTAINER}' must be running. Start it first."

      # Check for an existing key
      local existing
      existing=$(docker exec "$CB_BACKEND_CONTAINER" sh -c \
        "grep -s '^CB_VAULT_KEY=' '${CB_DATA_DIR}/.env' | cut -d= -f2-" 2>/dev/null || true)

      if [[ -n "$existing" ]]; then
        _warn "A vault key already exists in ${CB_DATA_DIR}/.env."
        echo ""
        echo -e "  ${Y}Overwriting it will break decryption of any already-stored secrets.${R}"
        printf "  Overwrite anyway? [y/N] "
        read -r reply < /dev/tty
        echo ""
        case "$reply" in
          [yY][eE][sS]|[yY]) ;;
          *) _info "Aborted — existing key kept."; return ;;
        esac
      fi

      _info "Generating vault key..."
      local key
      key=$(_gen_fernet_key)

      # Pass key via env var to avoid shell-quoting surprises
      docker exec -e "CB_NEW_VAULT_KEY=${key}" "$CB_BACKEND_CONTAINER" sh -c "
        mkdir -p '${CB_DATA_DIR}'
        env_file='${CB_DATA_DIR}/.env'
        if [ -f \"\$env_file\" ] && grep -q '^CB_VAULT_KEY=' \"\$env_file\"; then
          sed -i 's|^CB_VAULT_KEY=.*|CB_VAULT_KEY='\"\$CB_NEW_VAULT_KEY\"'|' \"\$env_file\"
        elif [ -f \"\$env_file\" ]; then
          printf '\nCB_VAULT_KEY=%s\n' \"\$CB_NEW_VAULT_KEY\" >> \"\$env_file\"
        else
          printf 'CB_VAULT_KEY=%s\n' \"\$CB_NEW_VAULT_KEY\" > \"\$env_file\"
        fi
        chmod 600 \"\$env_file\"
      "

      _ok "Vault key written to ${CB_DATA_DIR}/.env in container '${CB_BACKEND_CONTAINER}'."

      if [[ "$CB_MODE" == "compose" ]]; then
        _info "Restarting backend container to apply the key..."
        docker restart "$CB_BACKEND_CONTAINER"
      else
        _info "Restarting container to apply the key..."
        docker restart "$CB_CONTAINER"
      fi
      _ok "Vault recovered. Check 'cb status' to confirm the service is healthy."
      ;;

    binary)
      local env_file="$CB_BINARY_ENV_FILE"

      if grep -q "^CB_VAULT_KEY=" "$env_file" 2>/dev/null; then
        _warn "A vault key already exists in ${env_file}."
        echo ""
        echo -e "  ${Y}Overwriting it will break decryption of any already-stored secrets.${R}"
        printf "  Overwrite anyway? [y/N] "
        read -r reply < /dev/tty
        echo ""
        case "$reply" in
          [yY][eE][sS]|[yY]) ;;
          *) _info "Aborted — existing key kept."; return ;;
        esac
      fi

      _info "Generating vault key..."
      local key
      key=$(_gen_fernet_key)

      if [[ -f "$env_file" ]]; then
        if grep -q "^CB_VAULT_KEY=" "$env_file"; then
          sudo sed -i "s|^CB_VAULT_KEY=.*|CB_VAULT_KEY=${key}|" "$env_file"
        else
          printf "\nCB_VAULT_KEY=%s\n" "$key" | sudo tee -a "$env_file" >/dev/null
        fi
      else
        printf "CB_VAULT_KEY=%s\n" "$key" | sudo tee "$env_file" >/dev/null
      fi
      sudo chmod 640 "$env_file"

      _ok "Vault key written to ${env_file}."
      _info "Restarting service to apply the key..."
      sudo systemctl restart circuit-breaker
      _ok "Vault recovered."
      ;;
  esac

  echo ""
}

cmd_version() {
  case "$CB_MODE" in
    docker|compose)
      _require_docker
      if _container_running "$CB_BACKEND_CONTAINER"; then
        docker exec "$CB_BACKEND_CONTAINER" cat /app/VERSION 2>/dev/null \
          || docker inspect --format '{{.Config.Image}}' "$CB_BACKEND_CONTAINER" 2>/dev/null \
          || _warn "Could not determine version."
      else
        _warn "Container '${CB_BACKEND_CONTAINER}' is not running."
      fi
      ;;
    binary)
      "$CB_BINARY" --version 2>/dev/null \
        || cat /etc/circuit-breaker/version 2>/dev/null \
        || _warn "Version unknown."
      ;;
  esac
}

# The uninstaller for docker/compose/binary installs is the repo's uninstall.sh.
# No installer copies it to /usr/local/bin/uninstall-circuit-breaker today, so
# that path is only honoured when an operator has put it there themselves; the
# checkout next to this script is the case that actually happens, and a plain
# "not found" error is useless when the real command is one curl away.
_CB_UNINSTALL_URL="https://raw.githubusercontent.com/BlkLeg/circuitbreaker/main/uninstall.sh"

cmd_uninstall() {
  local here
  here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)

  if [[ -x /usr/local/bin/uninstall-circuit-breaker ]]; then
    exec /usr/local/bin/uninstall-circuit-breaker
  elif [[ -f "$here/uninstall.sh" ]]; then
    _info "Running ${here}/uninstall.sh"
    exec bash "$here/uninstall.sh"
  else
    _fail "$(printf '%s\n' \
      "No uninstaller on this host." \
      "  Run it from a checkout:  bash uninstall.sh" \
      "  Or fetch it:             curl -fsSL ${_CB_UNINSTALL_URL} | bash")"
  fi
}

###############################################################################
# USAGE
###############################################################################

usage() {
  echo ""
  echo -e "  ${B}cb${R} — Circuit Breaker CLI"
  echo ""
  echo -e "  ${GR}Usage:${R}  cb <command> [options]"
  echo ""
  echo -e "  ${G}Commands:${R}"
  echo -e "    status              Show container / service status"
  echo -e "    doctor              Run health checks and diagnose issues"
  echo -e "    logs [-f]           Show logs  (${GR}-f${R} to follow in real-time)"
  echo -e "    restart             Restart Circuit Breaker"
  echo -e "    update              Pull latest image and restart  ${GR}(docker mode)${R}"
  echo -e "    backup              Full-state snapshot (database, uploads, config, vault key)"
  echo -e "    restore <archive>   Restore a snapshot  ${GR}(destructive; --yes --force --no-safety-snapshot)${R}"
  echo -e "    migrate status      Report the schema revision  ${GR}(exit 3 when behind)${R}"
  echo -e "    migrate upgrade     Apply pending database migrations"
  echo -e "    token ...           Scoped API tokens  ${GR}(create, list, rotate, revoke)${R}"
  echo -e "    user ...            Local accounts  ${GR}(list, create, set-role, disable, enable)${R}"
  echo -e "    agent ...           Agent fleet  ${GR}(list, approve, revoke)${R}"
  echo -e "    config validate     Validate the configuration before it is used"
  echo -e "    vault-recover       Recover an uninitialized vault  ${GR}(recovery path only)${R}"
  echo -e "    version             Show installed version"
  echo -e "    uninstall           Remove Circuit Breaker from this system"
  echo -e "    help                Show this help"
  echo ""
  echo -e "  ${GR}Config : ${_CONF}${R}"
  echo -e "  ${GR}Mode   : ${CB_MODE}${R}"
  echo ""
}

###############################################################################
# MAIN
###############################################################################

case "${1:-help}" in
  status)          cmd_status ;;
  doctor)          cmd_doctor ;;
  logs)            cmd_logs "${2:-}" ;;
  restart)         cmd_restart ;;
  update)          cmd_update ;;
  backup)          cmd_backup ;;
  restore)         cmd_restore "${@:2}" ;;
  migrate)         cmd_migrate "${@:2}" ;;
  token)           cmd_token "${@:2}" ;;
  user)            cmd_user "${@:2}" ;;
  agent)           cmd_agent "${@:2}" ;;
  config)          cmd_config "${2:-}" ;;
  vault-recover)   cmd_vault_recover ;;
  version)         cmd_version ;;
  uninstall)       cmd_uninstall ;;
  help|--help|-h)  usage ;;
  *) echo -e "\n  Unknown command: ${RED}$1${R}\n"; usage; exit 1 ;;
esac
