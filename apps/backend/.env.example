# Copy this file to .env and edit as needed
DATABASE_URL=sqlite:///./data/app.db
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Base directory for all user uploads (profile photos, docs, branding, icons).
# In Docker single-image deployments this is set to /data/uploads via ENV in the Dockerfile.
# In Docker Compose it is set to /app/data/uploads via the environment block.
UPLOADS_DIR=data/uploads

# ── Production dependency safety ──────────────────────────────────────────────
# Production startup requires Redis/NATS, shared Redis-backed rate limits, strong
# signing/encryption secrets, and a controlled outbound HTTP egress proxy.
# Tests and emergency break-glass operation may set CB_ALLOW_DEGRADED_DEPENDENCIES=true.
CB_ALLOW_DEGRADED_DEPENDENCIES=false

# Leave blank to derive rate-limit storage from CB_REDIS_URL / REDIS_URL.
# Do not use memory:// outside tests or explicitly degraded operation.
# CB_RATE_LIMIT_STORAGE_URL=redis://:password@redis-host:6379/0

# X-Forwarded-For is honored only when the immediate peer is in this CIDR list.
CB_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Required for strict production startup. Point this at an operator-managed
# forward proxy that blocks link-local/metadata and non-approved destinations.
# CB_EGRESS_PROXY_URL=http://egress-proxy.local:3128

# ── Developer mode ─────────────────────────────────────────────────────────────
# When DEV_MODE=true:
#   - JWT auth checks are bypassed (all requests treated as authenticated).
#   - SQL query logging is enabled (verbose).
#   - Error responses include full stack traces.
# NEVER enable in production.
DEV_MODE=false

# ── Analytics DB ───────────────────────────────────────────────────────────────
# Optional DuckDB path for analytics queries.  Leave empty to use SQLite.
# ANALYTICS_DB_PATH=data/analytics.duckdb
