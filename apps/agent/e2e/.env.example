# Template for the e2e harness's env file. `.env` is gitignored (GOV-12)
# and generated from this file by `ensure_env.py` — which conftest.py's
# autouse fixture runs before the first test and .github/workflows/e2e.yml
# runs as its own step, so neither a local run nor CI needs a manual copy.
# Run `python ensure_env.py` by hand only if you want the file before
# invoking pytest (e.g. to run `docker compose ... config` yourself).
# Adding a key here is enough: ensure_env.py appends keys an existing `.env`
# lacks, carrying this comment block with them, and never overwrites a value
# that is already set.
# The values below are placeholders — any fake value of the right shape
# works, since nothing here reaches a deployed environment.
# Also satisfies the root docker-compose.yml's ${VAR:?...} requirements,
# since `extends` interpolates the extended file's variables using this
# project's env context (the directory of the -f file passed to `docker
# compose`, i.e. this directory), not the extended file's own directory.
CB_DB_PASSWORD=replace-me-e2e-password
# Must be base64 of exactly 32 bytes; generate one with
# `openssl rand -base64 32`. This placeholder decodes to the ASCII
# string REPLACE-ME-e2e-vault-key-32bytes, so it is the right shape
# but obviously not a key anyone should keep.
CB_VAULT_KEY=UkVQTEFDRS1NRS1lMmUtdmF1bHQta2V5LTMyYnl0ZXM=
CB_JWT_SECRET=replace-me-jwt-secret-at-least-32-bytes-long
NATS_AUTH_TOKEN=replace-me-nats-token-at-least-32-bytes-long
CB_PORT=18080
CB_PORT_HTTPS=8443
# Isolated from a real dev deployment's ../../../circuitbreaker-data — the
# base compose file's volume path is resolved relative to its own
# directory (repo root), not this .env's directory, so this must be an
# explicit absolute-ish override or it would silently share/clobber a real
# local deployment's database.
CB_DATA_DIR=./e2e-data

