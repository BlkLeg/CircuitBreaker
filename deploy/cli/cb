_cb_json_get() {
  local key="$1"
  if command -v python3 >/dev/null 2>&1; then
    CB_IDENTITY_JSON="$CB_IDENTITY_JSON" python3 -c '
import json, os, sys
data = json.loads(os.environ.get("CB_IDENTITY_JSON") or "{}")
key = sys.argv[1]
val = data.get(key)
if val is None:
    sys.exit(0)
if isinstance(val, list):
    print(",".join(str(x) for x in val))
else:
    print(val)
' "$key" 2>/dev/null || true
  fi
}

_load_install_identity() {
  local path=""
  if [[ -n "${CB_IDENTITY_PATH:-}" ]]; then
    if [[ -f "$CB_IDENTITY_PATH" && -r "$CB_IDENTITY_PATH" ]]; then
      path="$CB_IDENTITY_PATH"
    else
      return 1
    fi
  elif command -v cb_find_install_identity >/dev/null 2>&1; then
    path="$(cb_find_install_identity 2>/dev/null || true)"
  fi
  if [[ -z "$path" && -z "${CB_IDENTITY_PATH:-}" ]]; then
    local candidate
    for candidate in \
      /etc/circuitbreaker/install-identity.json \
      /etc/circuit-breaker/install-identity.json \
      ${CB_DATA_DIR:+"${CB_DATA_DIR}/install-identity.json"} \
      "$HOME/.circuit-breaker/install-identity.json"
    do
      [[ -n "$candidate" && -f "$candidate" && -r "$candidate" ]] || continue
      path="$candidate"
      break
    done
  fi
  [[ -n "$path" ]] || return 1
  if command -v cb_validate_install_identity_file >/dev/null 2>&1; then
    cb_validate_install_identity_file "$path" || return 1
  fi
  CB_IDENTITY_FILE="$path"
  CB_IDENTITY_JSON="$(cat "$path")"
  CB_IDENTITY_MODE="$(_cb_json_get mode)"
  CB_IDENTITY_LOADED=1
  local v
  v="$(_cb_json_get data_dir)"; [[ -n "$v" ]] && CB_DATA_DIR="$v"
  v="$(_cb_json_get env_file)"; [[ -n "$v" ]] && { [[ "$CB_IDENTITY_MODE" == "package" ]] && CB_BINARY_ENV_FILE="$v"; }
  v="$(_cb_json_get container_name)"; [[ -n "$v" ]] && CB_CONTAINER="$v"
  v="$(_cb_json_get compose_file)"; [[ -n "$v" ]] && CB_COMPOSE_FILE="$v"
  v="$(_cb_json_get health_url)"; [[ -n "$v" ]] && CB_HEALTH_URL="$v"
  v="$(_cb_json_get cli_path)"; [[ -n "$v" ]] && CB_CLI_PATH="$v"
  case "$CB_IDENTITY_MODE" in
    mono)
      if [[ -n "$CB_COMPOSE_FILE" ]]; then
        CB_MODE="compose"
      else
        CB_MODE="docker"
      fi
      CB_BACKEND_CONTAINER="${CB_CONTAINER}"
      CB_DATA_DIR="${CB_DATA_DIR:-/data}"
      CB_PORT="${CB_PORT:-8080}"
      ;;
    package)
      CB_MODE="binary"
      CB_DATA_DIR="${CB_DATA_DIR:-/var/lib/circuit-breaker}"
      CB_PORT="${CB_PORT:-8000}"
      ;;
    native|proxmox)
      CB_MODE="native"
      CB_DATA_DIR="${CB_DATA_DIR:-/var/lib/circuitbreaker}"
      CB_PORT="${CB_PORT:-8000}"
      [[ -f /etc/circuitbreaker/.env ]] && {
        # shellcheck source=/dev/null
        set -a; source /etc/circuitbreaker/.env; set +a
      }
      ;;
    *)
      return 1
      ;;
  esac
  return 0
}

if _load_install_identity; then
  :
elif [[ -f "$_CONF" ]]; then
  CB_HAS_LEGACY_CONF=1
  # shellcheck source=/dev/null
  source "$_CONF"
  _warn "Using legacy install.conf at ${_CONF}; migrate by re-running the installer so install-identity.json is written."
  # Legacy conf may set CB_MODE=docker|compose|binary — keep those values.
  if [[ -z "${CB_BACKEND_CONTAINER:-}" ]]; then
    [[ "$CB_MODE" == "compose" ]] && CB_BACKEND_CONTAINER="cb-backend" || CB_BACKEND_CONTAINER="${CB_CONTAINER:-}"
  fi
  if [[ -z "${CB_DATA_DIR:-}" ]]; then
    [[ "$CB_MODE" == "compose" ]] && CB_DATA_DIR="/app/data" || CB_DATA_DIR="/data"
  fi
else
  _warn "Install identity not found — run 'cb info' for repair guidance. Most commands require identity."
fi

# Apply remaining mode-specific defaults ONLY when identity or legacy conf set a mode.
if [[ -n "$CB_MODE" ]]; then
  if [[ -z "$CB_BACKEND_CONTAINER" && -n "$CB_CONTAINER" ]]; then
    CB_BACKEND_CONTAINER="$CB_CONTAINER"
  fi
  if [[ -z "$CB_DATA_DIR" ]]; then
    case "$CB_MODE" in
      compose) CB_DATA_DIR="/app/data" ;;
      docker) CB_DATA_DIR="/data" ;;
      binary) CB_DATA_DIR="/var/lib/circuit-breaker" ;;
      native) CB_DATA_DIR="/var/lib/circuitbreaker" ;;
    esac
  fi
fi

_require_identity_or_fail() {
  local cmd="$1"
  if [[ -n "$CB_MODE" ]]; then
    return 0
  fi
  _fail "$(printf '%s\n' \
    "Command '${cmd}' requires install identity (or legacy install.conf)." \
    "  $(command -v repair_hint_for_mode >/dev/null 2>&1 && true)" \
    "  Re-run the installer for your mode so install-identity.json is written." \
    "  Then: cb info")"
}

# Commands allowed without identity.
_CB_IDENTITY_OPTIONAL_CMDS="info help version doctor setup setup-token diag"

# ── Internal helpers ──────────────────────────────────────────────────────────
_require_docker() {
  command -v docker >/dev/null 2>&1 || _fail "Docker is not installed or not in PATH."
  docker info >/dev/null 2>&1       || _fail "Docker daemon is not running."
}

_require_binary() {
  local path="$1" why="${2:-}"
  [[ -e "$path" ]] || _fail "${path} not found${why:+ — $why}"
  [[ -x "$path" ]] || _fail "${path} is not executable${why:+ — $why}"
}

_require_postgres_client() {
  command -v pg_dump >/dev/null 2>&1 \
    || _fail "pg_dump is not installed on this host — install the PostgreSQL client package (postgresql-client) and retry."
}

_container_running() {
  local name="${1:-$CB_CONTAINER}"
  [[ -n "$name" ]] || return 1
  docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${name}$"
}

_gen_fernet_key() {
  command -v openssl >/dev/null 2>&1 \
    || _fail "openssl is required to generate a vault key. Install it and retry."
  openssl rand -base64 32
}

_unsupported() {
  local op="$1" reason="$2" alt="$3"
  _fail "$(printf '%s\n' \
    "Operation '${op}' is unavailable for mode '${CB_IDENTITY_MODE:-${CB_MODE:-unknown}}'." \
    "  Why: ${reason}" \
    "  Use: ${alt}")"
}

_DB_CONN_SH='if [ -n "${CB_DB_URL:-}" ]; then set -- "$CB_DB_URL"; else export PGPASSWORD="${CB_DB_PASSWORD:-}"; set -- -h 127.0.0.1 -p 5432 -U breaker circuitbreaker; fi'

