#!/usr/bin/env bash
#
# cb — Circuit Breaker command-line tool
#
# Installed to /usr/local/bin/cb by install.sh  (or: sudo install -Dm755 ./cb /usr/local/bin/cb)
#
# Usage: cb <command> [options]
#
# Commands:
#   status        Show service / container status
#   doctor        Run health checks and diagnose issues
#   diag bundle   Write one redacted .tar.gz to hand over for an issue
#   logs [-f]     Show (or follow) logs
#   restart       Restart Circuit Breaker
#   update        Pull latest image and restart  (docker mode only)
#   backup        Full-state snapshot: database, uploads, config, vault key
#                 [--encrypt-to age1…]  also write an encrypted copy safe to
#                 store off this host
#   restore       Restore a full-state snapshot  (destructive)
#                 [--identity FILE]     required for an encrypted .age snapshot
#   migrate       Database schema: migrate status | migrate upgrade
#   token         Scoped API tokens: create | list | rotate | revoke
#   user          Local accounts: list | create | set-role | disable | enable
#   agent         Agent fleet: list | approve | revoke
#   config        Validate the configuration  (cb config validate)
#   vault-recover Recover from an uninitialized vault  (after-crash / headless deploy)
#   version       Show installed version
#   uninstall     Remove Circuit Breaker from this system
#   help          Show this help
#
# Modes (set in ~/.circuit-breaker/install.conf):
#   docker   — single container deployed by install.sh
#   compose  — multi-container stack deployed by docker compose
#   binary   — native binary managed by systemd
#

set -eo pipefail

# ── Paths ─────────────────────────────────────────────────────────────────────
_CB_HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
for _id_lib in \
  "${_CB_HERE}/deploy/lib/install-identity.sh" \
  /usr/local/lib/circuitbreaker/install-identity.sh \
  /opt/circuitbreaker/deploy/lib/install-identity.sh
do
  if [[ -f "$_id_lib" ]]; then
    # shellcheck source=/dev/null
    source "$_id_lib"
    break
  fi
done

# Test seam only — real installs never set this. It prefixes the absolute
# filesystem paths `cb diag bundle` reads (the env file, the install log) so
# tests can point the CLI at a fixture tree instead of the real root. Nothing
# else in this script honours it; do not use it to sandbox any other command.
CB_ROOT_PREFIX="${CB_ROOT_PREFIX:-}"

CB_CONFIG_DIR="${CB_CONFIG_DIR:-$HOME/.circuit-breaker}"
_CONF="$CB_CONFIG_DIR/install.conf"
if [[ ! -f "$_CONF" && -f /etc/circuit-breaker/install.conf ]]; then
  _CONF="/etc/circuit-breaker/install.conf"
fi

# ── Colors ────────────────────────────────────────────────────────────────────
R='\e[0m'
G='\e[38;5;154m'
B='\e[1m'
GR='\e[90m'
Y='\e[33m'
RED='\e[91m'
LINE=" ${G}─────────────────────────────────────────${R}"

_ok()   { echo -e "${GR}[${R}${G} OK ${R}${GR}]${R} $*"; }
_info() { echo -e "${GR}[${R}${G} INFO ${R}${GR}]${R} $*" >&2; }
_warn() { echo -e "${GR}[${R}${Y}NOTICE${R}${GR}]${R} $*" >&2; }
_fail() { echo -e "${GR}[${R}${RED}ERROR${R}${GR}]${R} $*" >&2; exit 1; }

# Single source of truth for the substitution patterns _redact_stream and
# _redact_evidence both apply. Emits Python source that operates on a
# variable named `text` already bound in the caller's scope — never define
# these regexes a third time inline; add or change a pattern here only.
# test_redact_functions_share_pattern_set (tests/build/test_diag_bundle_redaction.py)
# asserts both functions embed exactly this output, so a future edit to one
# and not the other fails the build instead of shipping a silent gap.
_redact_pattern_source() {
  cat <<'PY'
# Key pattern: unanchored, full identifier ([A-Za-z0-9_]* on both sides of the
# alternation) so CB_REDIS_PASSWORD, CB_JWT_SECRET and an inline
# "... CB_JWT_SECRET=x" occurrence in a log line all match — not just a
# key that is exactly one of the listed words. Over-redaction (e.g. a
# variable that merely contains KEY) is accepted; missing a real secret is
# not.
text = re.sub(
    r"(?i)([A-Za-z0-9_]*(?:SECRET|PASSWORD|PASSWD|TOKEN|KEY|CREDENTIAL)[A-Za-z0-9_]*)=\S+",
    r"\1=[REDACTED]",
    text,
)
# URL pattern: scheme-agnostic (any "word://", not a fixed list — this is
# what missed http/https entirely) and empty-userinfo tolerant (`*` on the
# userinfo class, not `+` — this is what missed "redis://:pw@", which is
# exactly what deploy/setup.sh writes for CB_REDIS_URL). Also handles a
# compound scheme like "postgresql+asyncpg://", which the async session DSN
# is rewritten to and which a fixed alternation of scheme names cannot
# match. Both the userinfo and the password are redacted.
text = re.sub(
    r"(?i)([a-z][a-z0-9+.\-]*://)([^:/@\s]*):([^@/\s]+)@",
    r"\1[REDACTED]:[REDACTED]@",
    text,
)
PY
}

_redact_evidence() {
  # Bound + redact operator-facing evidence for doctor JSON/human tails.
  # Uses the exact same substitution patterns as _redact_stream, via
  # _redact_pattern_source — only the 500-character truncation below is
  # unique to this function, deliberately, for short doctor evidence tails.
  local text="${1:-}"
  if command -v python3 >/dev/null 2>&1; then
    CB_EVIDENCE_IN="$text" CB_REDACT_PATTERNS="$(_redact_pattern_source)" python3 -c '
import os, re
text = os.environ.get("CB_EVIDENCE_IN") or ""
exec(os.environ["CB_REDACT_PATTERNS"])
for key in ("CB_VAULT_KEY", "CB_JWT_SECRET", "CB_DB_PASSWORD", "NATS_AUTH_TOKEN"):
    val = os.environ.get(key) or ""
    if len(val) >= 4 and val in text:
        text = text.replace(val, "[REDACTED]")
print(text[:500], end="")
' 2>/dev/null || printf '%s' "${text:0:500}"
  else
    printf '%s' "${text:0:500}"
  fi
}

# Everything here is written to be pasted into a public issue, so every source
# goes through the redaction that source already has — cb_env_redacted for the
# env file, the CLI's own masking for doctor output — and nothing is added
# without a matching assertion in tests/build/test_diag_bundle_redaction.py.
#
# Never uploads. The air-gap contract forbids an outbound call, and an operator
# handing over a file should be the one who decides where it goes.
_redact_stream() {
  # Same substitution patterns as _redact_evidence, via _redact_pattern_source
  # — but reading stdin to stdout whole, with NO truncation. _redact_evidence
  # exists for short doctor evidence tails and cuts everything to 500
  # characters; install.log and journal.txt run to hundreds of lines, and
  # piping either through that would ship the first 500 characters as
  # "redacted" while the rest — including any secret past that point — goes
  # out verbatim.
  #
  # Fails closed: if python3 is unavailable, nothing is written to stdout and
  # this returns non-zero. The caller MUST treat that as fatal to the whole
  # bundle. A missing interpreter must never degrade into shipping a stream
  # unredacted — that is exactly the failure `cb diag bundle` exists to avoid.
  if ! command -v python3 >/dev/null 2>&1; then
    return 1
  fi
  CB_REDACT_PATTERNS="$(_redact_pattern_source)" python3 -c '
import os, re, sys
text = sys.stdin.read()
exec(os.environ["CB_REDACT_PATTERNS"])
for key in ("CB_VAULT_KEY", "CB_JWT_SECRET", "CB_DB_PASSWORD", "NATS_AUTH_TOKEN"):
    val = os.environ.get(key) or ""
    if len(val) >= 4 and val in text:
        text = text.replace(val, "[REDACTED]")
sys.stdout.write(text)
'
}

_doctor_emit_json() {
  printf '%s\n' "${RESULTS[@]}" | python3 -c '
import sys, json
rows = [json.loads(line) for line in sys.stdin if line.strip()]
print(json.dumps(rows, indent=2))
'
}

