[Unit]
Description=Circuit Breaker Backend API
After=circuitbreaker-pgbouncer.service circuitbreaker-redis.service circuitbreaker-nats.service
Requires=circuitbreaker-pgbouncer.service circuitbreaker-redis.service circuitbreaker-nats.service
# Without this, `systemctl stop/restart circuitbreaker.target` — what
# run_upgrade and the installer journey both use to quiesce the stack before
# swapping the runtime tree — only stops the target unit itself; Wants= is a
# start-time pull, not a stop propagation. Confirmed live: without PartOf=,
# the backend process survives an "upgrade" untouched while its files are
# replaced underneath it, and a failed --selftest's rollback restores files
# a live process was never actually separated from in the first place.
PartOf=circuitbreaker.target

[Service]
Type=exec
User=breaker
Group=breaker
Slice=circuitbreaker.slice
WorkingDirectory=/opt/circuitbreaker
EnvironmentFile=/etc/circuitbreaker/.env
# Force Python to use UTF-8 for all I/O. Without this, systemd's C/POSIX locale
# causes Python to default to ASCII for stdout/stderr, raising UnicodeEncodeError
# whenever a log message contains non-ASCII text (e.g. device hostnames found
# during network fingerprinting). (#75)
Environment="PYTHONUTF8=1"
Environment="PYTHONIOENCODING=utf-8"

# Each unit gets its own scratch directory under the data dir rather than the
# shared /tmp. PrivateTmp= is deliberately not used: discovery reads the host's
# real /tmp/dnsmasq.leases and /tmp/dhcp.leases by absolute path.
Environment="TMPDIR=/var/lib/circuitbreaker/run/%N"
ExecStartPre=/bin/mkdir -p /var/lib/circuitbreaker/run/%N
# No RuntimeDirectory=circuitbreaker here. systemd removes a runtime
# directory whenever ANY unit declaring it stops, even while the other
# declarers are running, and this one is shared with the backend, the five
# workers and cb-helperd. /usr/lib/tmpfiles.d/circuitbreaker.conf owns it
# instead; see deploy/misc/circuitbreaker.tmpfiles.conf.
ExecStartPre=/bin/sh -c 'umask 077; grep -E "^CB_VAULT_KEY=" /etc/circuitbreaker/.env > /run/circuitbreaker/vault.env 2>/dev/null || true'
EnvironmentFile=-/run/circuitbreaker/vault.env
ExecStartPre=/opt/circuitbreaker/scripts/validate-secrets.sh
ExecStartPre=/opt/circuitbreaker/scripts/wait-for-services.sh
ExecStart=/opt/circuitbreaker/bin/circuit-breaker --host 127.0.0.1 --port 8000 --workers 1
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
Restart=on-failure
RestartSec=10s
MemoryMax=1G
LimitNOFILE=65536
CPUQuota=200%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cb-backend

[Install]
WantedBy=multi-user.target
