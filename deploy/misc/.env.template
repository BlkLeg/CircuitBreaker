
# Circuit Breaker Environment Configuration
# Generated by install.sh on ${CB_INSTALL_DATE}
# DO NOT EDIT SECRETS MANUALLY — regeneration will break existing data

# ===== Secrets (auto-generated) =====
CB_JWT_SECRET=${CB_JWT_SECRET}
CB_VAULT_KEY=${CB_VAULT_KEY}
CB_DB_PASSWORD=${CB_DB_PASSWORD}
CB_REDIS_PASSWORD=${CB_REDIS_PASSWORD}
CB_NATS_TOKEN=${CB_NATS_TOKEN}

# ===== Connection Strings =====
CB_DB_URL=postgresql://breaker:${CB_DB_PASSWORD}@127.0.0.1:5432/circuitbreaker
CB_DB_POOL_URL=postgresql://breaker:${CB_DB_PASSWORD}@127.0.0.1:6432/circuitbreaker
CB_REDIS_URL=redis://:${CB_REDIS_PASSWORD}@127.0.0.1:6379/0
CB_NATS_URL=nats://127.0.0.1:4222

# ===== SEC-5 outbound/dependency safety =====
# Point this at an operator-managed HTTP forward proxy that blocks
# link-local/metadata and non-approved destinations. Public outbound requests
# are routed through it.
CB_EGRESS_PROXY_URL=${CB_EGRESS_PROXY_URL}
# Most single-node hosts have no forward proxy to point the line above at.
# This records that running without one is a decision, not an omission, and
# waives only the proxy requirement — outbound requests are still checked by
# the SSRF/URL policy, and Redis, NATS, rate-limit storage and secrets all
# still fail closed. Set it to false once CB_EGRESS_PROXY_URL is configured.
CB_ALLOW_DIRECT_EGRESS=${CB_ALLOW_DIRECT_EGRESS}
# Leave empty to derive application rate-limit storage from CB_REDIS_URL.
CB_RATE_LIMIT_STORAGE_URL=${CB_RATE_LIMIT_STORAGE_URL}
CB_TRUSTED_PROXY_CIDRS=${CB_TRUSTED_PROXY_CIDRS}
CB_ALLOW_DEGRADED_DEPENDENCIES=${CB_ALLOW_DEGRADED_DEPENDENCIES}

# ===== TLS / ACME =====
# Let's Encrypt account email, read by services/acme_service.py. Set by install.sh
# --email. Issuance refuses without it rather than inventing an address.
CB_TLS_EMAIL=${CB_EMAIL}

# ===== Paths =====
CB_DATA_DIR=${CB_DATA_DIR}
CB_UPLOADS_DIR=${CB_DATA_DIR}/uploads
CB_STATIC_DIR=/opt/circuitbreaker/share/frontend
CB_SHARE_DIR=/opt/circuitbreaker/share
CB_ALEMBIC_INI=/opt/circuitbreaker/share/backend/alembic.ini
CB_AGENT_BINARIES_DIR=/opt/circuitbreaker/agent-binaries
CB_LOG_DIR=${CB_DATA_DIR}/logs

# ===== Aliases (non-prefixed names for Python code) =====
UPLOADS_DIR=${CB_DATA_DIR}/uploads
NATS_URL=nats://127.0.0.1:4222
NATS_AUTH_TOKEN=${CB_NATS_TOKEN}

# ===== Application =====
CB_PORT=${CB_PORT}
CB_FQDN=${CB_FQDN}
CB_APP_URL=http://${CB_APP_HOST}
CB_ENV=production
# Set by the installer from --airgap / CB_AIRGAP. The application reads the same
# variable to suppress the outbound update check and any other egress, so a host
# installed offline stays offline at runtime instead of reaching out on first boot.
CB_AIRGAP=${CB_AIRGAP}
