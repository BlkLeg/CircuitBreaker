########## Stage 1: Build frontend ##########
FROM node:20.19.0-alpine3.21 AS frontend-builder

WORKDIR /app/frontend

# Install dependencies (cached layer)
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci

# Copy source and build — syncversion reads ../../VERSION to stamp the bundle
COPY VERSION /VERSION
COPY apps/frontend/ ./
RUN npm run build


########## Stage 2: Build agent binaries ##########
FROM golang:1.26-bookworm AS agent-builder

WORKDIR /src

# make/python3 aren't guaranteed present on the base golang image across
# versions; installed explicitly so `make manifest` (which shells out to
# gen_manifest.py) works regardless. python3-cryptography is what signs the
# binaries: without it gen_manifest.py's signing branch ImportErrors, so a build
# handed a key would have failed rather than produced signatures.
RUN apt-get update && apt-get install -y --no-install-recommends \
    make \
    python3 \
    python3-cryptography \
    && rm -rf /var/lib/apt/lists/*

# Slice 4.2 (F3). The public half is a build arg because it is public by
# construction — it is compiled into the binary via -ldflags and is readable
# from any agent with `cb-agent signing-key`.
#
# Until this existed, every agent binary in the mono image — the primary
# shipping artifact — was built with no embedded key and no .sig beside it, so
# 4.2 had no effect on the image most installs actually run. Only the native
# deb/rpm/apk path was ever plumbed.
ARG SIGNING_PUBKEY=

COPY VERSION /VERSION
COPY apps/agent/ ./

# VERSION is passed as an env var, not left to the Makefile's `git describe`
# fallback — this build context has no .git directory, and even if it did,
# the app's own /VERSION file (already the single source of truth for the
# frontend/backend stages above) is the version agent binaries must match.
#
# The private half arrives as a BuildKit secret, never a build arg: build args
# are recorded in image metadata and readable with `docker history`, which for
# the agent signing key would be worse than not signing at all. The mount exists
# only for the life of this RUN and is never written to a layer. An absent
# secret leaves the key empty, which is the documented self-hoster path —
# gen_manifest.py warns and emits unsigned binaries that run in warn mode.
RUN --mount=type=secret,id=agent_signing_key \
    AGENT_SIGNING_PRIVATE_KEY="$(cat /run/secrets/agent_signing_key 2>/dev/null || true)" \
    VERSION="$(cat /VERSION)" \
    make manifest SIGNING_PUBKEY="${SIGNING_PUBKEY}"


########## Stage 3: Assemble the application tree ##########
# The same script, pins and requirement files the native build uses, so the
# image and the deb carry a byte-identical runtime (runtime_digest in
# share/build-info.json; scripts/ci/assert_runtime_parity.py holds them equal).
# python:3.12-slim here is only the host interpreter that RUNS pbs_tree.py;
# nothing from it reaches the runtime image.
FROM python:3.12.14-slim-bookworm AS app-tree
WORKDIR /src
COPY VERSION scripts/pbs_tree.py ./scripts/
COPY VERSION ./VERSION
COPY packaging/python-build-standalone.pin ./packaging/
COPY packaging/wheels ./packaging/wheels
COPY apps/backend/requirements.txt apps/backend/requirements-pg.txt apps/backend/requirements-acme.txt ./apps/backend/
COPY apps/backend/alembic.ini ./apps/backend/alembic.ini
COPY apps/backend/migrations ./apps/backend/migrations
COPY apps/backend/src/app ./apps/backend/src/app
COPY --from=frontend-builder /app/frontend/dist /build/frontend
COPY --from=agent-builder /src/dist /build/agent-dist
# The interpreter archive is cached across builds; the pin's digest decides
# whether the cache is reused, so a bump can never hit a stale file.
RUN --mount=type=cache,target=/root/.cache/cb-pbs \
    python3 scripts/pbs_tree.py \
      --output /out/app \
      --cache-dir /root/.cache/cb-pbs \
      --frontend-dist /build/frontend \
      --agent-dist /build/agent-dist

# A one-file stage the CI parity job exports with
#   docker buildx build --target app-build-info --output type=local,dest=DIR
# so the image's provenance can be read without loading the whole image.
FROM scratch AS app-build-info
COPY --from=app-tree /out/app/share/build-info.json /build-info.json


########## Stage 4: Runtime image (all services + supervisor) ##########
# checkov:skip=CKV_DOCKER_3,CKV_DS_0002: Mono runtime intentionally starts as root to run entrypoint bootstrap tasks (volume ownership, embedded service wiring) before supervised processes run as breaker/root where required.
# trivy:ignore:DS-0002
FROM debian:12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /opt/circuitbreaker

# System services and tools:
# - nginx: serves SPA and proxies /api + WebSockets
# - supervisor: process manager for Postgres, NATS, backend, workers, nginx
# - postgresql: embedded DB (Debian Bookworm default is PostgreSQL 15)
# - nats-server: JetStream message bus
# - ca-certificates, curl: TLS + simple debugging
# Mono runtime tracks security updates from Debian bookworm; version pinning on
# apt packages is intentionally avoided to keep CVE fixes current.
# hadolint ignore=DL3008,DL3005
RUN apt-get update && apt-get upgrade -y --no-install-recommends && apt-get install -y --no-install-recommends \
    age \
    nginx \
    supervisor \
    postgresql \
    postgresql-client \
    nats-server \
    redis-server \
    pgbouncer \
    ca-certificates \
    curl \
    gnupg \
    bash \
    jq \
    netcat-traditional \
    openssl \
    tini \
    nmap \
    iputils-ping \
    snmp \
    libmagic1 \
    ipmitool \
    && rm -f /etc/ssl/private/ssl-cert-snakeoil.key /etc/ssl/certs/ssl-cert-snakeoil.pem \
    && if [ -d /etc/ssl/private ] && [ -n "$(find /etc/ssl/private -maxdepth 1 -type f -print -quit)" ]; then \
        echo "Unexpected private key material found in /etc/ssl/private"; \
        find /etc/ssl/private -maxdepth 1 -type f; \
        exit 1; \
    fi \
    && rm -rf /var/lib/apt/lists/*

# TimescaleDB extension for PostgreSQL 15 (time-series hypertables + compression)
# PGDG repo is added here so postgresql-15 >= 15.17 is available; Debian bookworm default
# ships 15.16 which is too old to satisfy timescaledb's dependency. apt will upgrade
# postgresql-15 automatically when resolving the timescaledb install.
# --retry on both key fetches. These reach postgresql.org and packagecloud.io
# over the public internet from a GitHub runner, and a single unretried curl is
# a coin-flip on every release: v0.4.3's first attempt died here with
#
#     curl: (35) Recv failure: Connection reset by peer
#     gpg: no valid OpenPGP data found.
#
# after Derive Version and the Tier 0 gate had already passed. A transient reset
# on a third-party host should cost seconds, not a whole release run — and
# because `curl -f` exits non-zero into a pipe, the only symptom downstream was
# gpg refusing empty input.
#
# --retry-all-errors is what makes this cover a reset: plain --retry only retries
# transient HTTP codes and timeouts, not a connection torn down mid-transfer.
# hadolint ignore=DL3008,DL3005,DL4006
RUN curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors https://www.postgresql.org/media/keys/ACCC4CF8.asc \
         | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
         > /etc/apt/sources.list.d/pgdg.list \
    && curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors https://packagecloud.io/timescale/timescaledb/gpgkey \
         | gpg --dearmor -o /usr/share/keyrings/timescaledb.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/timescaledb.gpg] https://packagecloud.io/timescale/timescaledb/debian/ bookworm main" \
         > /etc/apt/sources.list.d/timescaledb.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends timescaledb-2-postgresql-15 \
    && rm -rf /var/lib/apt/lists/*

# The application: one tree, the same one the native packages install. Every
# Python process in this image goes through bin/cb-python or bin/circuit-breaker
# (docker/supervisord.mono.conf, docker/20-migrate.sh); /usr/local/bin/python3
# and /usr/bin/python point at it so the `python3 -c` helpers in docker/*.sh use
# the same interpreter. Debian's own python3 arrives with `supervisor` and runs
# supervisord alone.
COPY --from=app-tree /out/app /opt/circuitbreaker
RUN ln -sf /opt/circuitbreaker/bin/cb-python /usr/local/bin/python3 \
    && ln -sf /opt/circuitbreaker/bin/cb-python /usr/bin/python \
    && ln -sf /opt/circuitbreaker/bin/circuit-breaker /usr/local/bin/circuit-breaker \
    && mkdir -p /app/frontend \
    && ln -sf /opt/circuitbreaker/share/frontend /app/frontend/dist \
    && rm -rf /usr/share/doc /usr/share/man /usr/share/locale /usr/share/info

# Mono-specific configs and init scripts
COPY docker/supervisord.mono.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/nginx.mono.conf /etc/nginx/nginx.conf
COPY docker/pgbouncer.ini /etc/pgbouncer/pgbouncer.ini
COPY docker/10-init-postgres.sh docker/20-migrate.sh docker/30-oobe.sh docker/entrypoint-mono.sh docker/run-postgres-if-embedded.sh /docker/
COPY deploy/lib/install-identity.sh /usr/local/lib/circuitbreaker/install-identity.sh
COPY cb /usr/local/bin/cb
RUN chmod +x /docker/*.sh /usr/local/bin/cb \
    && chmod 644 /usr/local/lib/circuitbreaker/install-identity.sh

# Runtime directories: /data/run/postgresql for socket/lock (breaker-owned); symlink so Postgres finds it
RUN mkdir -p /app /data /data/uploads /data/tls /data/certs /data/redis /data/run/postgresql /var/log/circuitbreaker \
    && chmod 1777 /data/run/postgresql \
    && rm -rf /var/run/postgresql \
    && ln -s /data/run/postgresql /var/run/postgresql \
    && groupadd -g 1000 breaker \
    && useradd -u 1000 -g 1000 --no-create-home --shell /sbin/nologin breaker \
    && chown -R breaker:breaker /app /data /var/log/circuitbreaker /opt/circuitbreaker

# Environment defaults for mono image (CB_DB_URL set at runtime in entrypoint from CB_DB_PASSWORD)
# Migrations run once in /docker/entrypoint-mono.sh via 20-migrate.sh; disable per-worker auto-migrate
# so uvicorn --workers N does not redundantly invoke Alembic from each process.
ENV CB_SHARE_DIR=/opt/circuitbreaker/share \
    CB_ALEMBIC_INI=/opt/circuitbreaker/share/backend/alembic.ini \
    ALEMBIC_CONFIG=/opt/circuitbreaker/share/backend/alembic.ini \
    STATIC_DIR=/opt/circuitbreaker/share/frontend \
    CB_AGENT_BINARIES_DIR=/opt/circuitbreaker/agent-binaries \
    CB_DATA_DIR=/data \
    UPLOADS_DIR=/data/uploads \
    NATS_URL=nats://127.0.0.1:4222 \
    CB_REDIS_URL=redis://127.0.0.1:6379/0 \
    CB_AUTO_MIGRATE=false

VOLUME ["/data"]

EXPOSE 8080 8443

# /livez, not /health or /readyz: a HEALTHCHECK failure restarts the container, and the
# only condition that warrants a restart is the process being unable to serve at all.
# A Postgres or Redis outage means "stop routing to me" (/readyz), not "kill me".
# The body is matched rather than trusting the status code alone: the :8080 server block
# 301-redirects everything it does not explicitly proxy, and `curl -f` treats a 301 as
# success — so a missing nginx location would otherwise make this probe always pass.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS --max-time 4 http://127.0.0.1:8080/api/v1/livez | grep -q '"alive"' || exit 1

# tini as PID1 (reaps zombies, forwards signals). Entrypoint starts as root to fix
# volume ownership, then supervisord drops to breaker for application processes.
ENTRYPOINT ["/usr/bin/tini", "--", "/bin/bash", "/docker/entrypoint-mono.sh"]
